<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PocketEncryptor.App.Models"
             x:Class="PocketEncryptor.App.MainPage"
             Title="PocketEncryptor"
             Shell.NavBarIsVisible="False">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="20,28,20,24" Spacing="20" MaximumWidthRequest="560">

            <!-- Header: logo + name -->
            <VerticalStackLayout Spacing="6">
                <HorizontalStackLayout Spacing="10">
                    <Image Source="{AppThemeBinding Light=pocketlock.png, Dark=pocketlock_dark.png}"
                           WidthRequest="34"
                           HeightRequest="34"
                           VerticalOptions="Center"
                           SemanticProperties.Description="PocketEncryptor logo" />
                    <Label Text="PocketEncryptor"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           VerticalOptions="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                </HorizontalStackLayout>
                <Label Text="Lock files with a password. Everything happens on this device."
                       TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </VerticalStackLayout>

            <!-- Mode switch (set automatically from the chosen files; can be changed) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="EncryptModeButton"
                        Text="Encrypt"
                        FontFamily="OpenSansSemibold"
                        CornerRadius="12"
                        Clicked="OnEncryptModeClicked"
                        SemanticProperties.Hint="Switch to encrypting files" />
                <Button x:Name="DecryptModeButton"
                        Grid.Column="1"
                        Text="Decrypt"
                        FontFamily="OpenSansSemibold"
                        CornerRadius="12"
                        Clicked="OnDecryptModeClicked"
                        SemanticProperties.Hint="Switch to decrypting files" />
            </Grid>

            <!-- Files: summary, Add, and one row per file with its size or result -->
            <Border x:Name="FilesBorder"
                    Padding="16"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2">
                        <Label x:Name="FileNameLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               LineBreakMode="MiddleTruncation"
                               VerticalOptions="End" />
                        <Label x:Name="FileInfoLabel"
                               Grid.Row="1"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                               VerticalOptions="Start" />
                        <Button x:Name="PickFileButton"
                                Grid.Column="1"
                                Grid.RowSpan="2"
                                Text="Choose files"
                                FontFamily="OpenSansSemibold"
                                CornerRadius="12"
                                VerticalOptions="Center"
                                Clicked="OnPickFileClicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="FileList" Spacing="8" IsVisible="False">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SelectedFile">
                                <Border Padding="12,4,4,4"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource ChipLight}, Dark={StaticResource ChipDark}}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                        <VerticalStackLayout Spacing="0" VerticalOptions="Center" Padding="0,4">
                                            <Label Text="{Binding Name}" FontSize="14" LineBreakMode="MiddleTruncation" />
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap"
                                                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding State}" Value="{x:Static models:FileState.Done}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding State}" Value="{x:Static models:FileState.Failed}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="×"
                                                FontSize="22"
                                                Padding="0"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                                Clicked="OnRemoveFileClicked"
                                                SemanticProperties.Description="{Binding Name, StringFormat='Remove {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Password -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Password" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    <Button x:Name="ShowPasswordButton"
                            Grid.Column="1"
                            Text="Show"
                            FontFamily="OpenSansSemibold"
                            Padding="12,0"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            Clicked="OnShowPasswordClicked"
                            SemanticProperties.Description="Show password" />
                </Grid>
                <Entry x:Name="PasswordEntry"
                       Placeholder="Enter password"
                       IsPassword="True"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       ReturnType="Next"
                       TextChanged="OnPasswordTextChanged"
                       Completed="OnPasswordCompleted"
                       SemanticProperties.Description="Password" />

                <!-- Strength meter (encrypt mode) -->
                <Grid x:Name="StrengthPanel" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" VerticalOptions="Center">
                        <BoxView x:Name="Strength1" HeightRequest="5" CornerRadius="3" />
                        <BoxView x:Name="Strength2" Grid.Column="1" HeightRequest="5" CornerRadius="3" />
                        <BoxView x:Name="Strength3" Grid.Column="2" HeightRequest="5" CornerRadius="3" />
                        <BoxView x:Name="Strength4" Grid.Column="3" HeightRequest="5" CornerRadius="3" />
                    </Grid>
                    <Label x:Name="StrengthLabel" Grid.Column="1" FontSize="13" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                </Grid>

                <Entry x:Name="ConfirmEntry"
                       Placeholder="Confirm password"
                       IsPassword="True"
                       IsSpellCheckEnabled="False"
                       IsTextPredictionEnabled="False"
                       ReturnType="Done"
                       TextChanged="OnPasswordTextChanged"
                       Completed="OnConfirmCompleted"
                       SemanticProperties.Description="Confirm password" />
                <Label x:Name="PasswordHintLabel" FontSize="13" IsVisible="False" />
            </VerticalStackLayout>

            <!-- Purge: encrypt mode, on platforms where the app can delete originals -->
            <Border x:Name="ReplacePanel"
                    Padding="14,10,8,10"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 14"
                    Stroke="{AppThemeBinding Light={StaticResource ErrorBorderLight}, Dark={StaticResource ErrorBorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReplaceLabelTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="Purge"
                               FontFamily="OpenSansSemibold"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                        <Label x:Name="ReplaceWarningLabel"
                               Text="Encryption over-writes the originals. Only password can recover files."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                    </VerticalStackLayout>
                    <CheckBox x:Name="ReplaceCheckBox"
                              Grid.Column="1"
                              VerticalOptions="Center"
                              Color="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                              SemanticProperties.Description="Purge"
                              CheckedChanged="OnReplaceChanged" />
                </Grid>
            </Border>

            <!-- Action -->
            <Button x:Name="RunButton"
                    Text="Encrypt file"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"
                    CornerRadius="16"
                    MinimumHeightRequest="54"
                    Clicked="OnRunClicked" />

            <!-- Progress -->
            <VerticalStackLayout x:Name="BusyPanel" Spacing="10" IsVisible="False">
                <ProgressBar x:Name="WorkProgress" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <ActivityIndicator x:Name="BusySpinner" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label x:Name="BusyLabel" Grid.Column="1" VerticalOptions="Center" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Text="Cancel"
                            CornerRadius="12"
                            Clicked="OnCancelClicked" />
                </Grid>
            </VerticalStackLayout>

            <!-- Result / error message -->
            <Border x:Name="StatusBorder" Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="False">
                <Label x:Name="StatusLabel" LineBreakMode="WordWrap" />
            </Border>

            <Label Text="On this device only. There is no way to recover a forgotten password."
                   FontSize="12"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
